        "expo-navigation-bar": "~5.0.8",
        "expo-network": "^8.0.8",
        "expo-notifications": "^0.32.16",
        "expo-router": "~6.0.0",
        "expo-secure-store": "~15.0.6",
        "expo-speech-recognition": "^3.1.1",
        "expo-splash-screen": "~31.0.8",
        "expo-status-bar": "~3.0.7",
        "expo-system-ui": "~6.0.7",
        "expo-web-browser": "~15.0.6",
        "lucide-react-native": "^0.552.0",
        "nativewind": "^4.1.23",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-native": "0.81.4",
        "react-native-actions-sheet": "^10.0.0-alpha.9",
