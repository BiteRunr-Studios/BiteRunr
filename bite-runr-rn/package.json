{
    "name": "native",
    "version": "1.0.0",
    "main": "expo-router/entry",
    "scripts": {
        "sync-styles": "node scripts/sync-style-tokens.cjs",
        "dev": "npm run sync-styles && expo start --clear",
        "android": "npm run sync-styles && expo run:android",
        "ios": "npm run sync-styles && expo run:ios",
        "phone": "npm run sync-styles && expo run:ios --device \"${IPHONE:-}\"",
        "prebuild": "npm run sync-styles && expo prebuild",
        "web": "npm run sync-styles && expo start --web",
        "convex:br": "convex dev --configure existing --team biterunr --project biterunr-d182d --dev-deployment cloud",
        "convex:brtest": "convex dev --configure existing --team biterunr --project biterunrtest --dev-deployment cloud",
        "eas:build": "eas build --platform ios --profile production --local --output ./build.ipa",
        "eas:build:android": "eas build --platform android --profile production --local --output ./build.aab"
    },
    "dependencies": {
        "@auth/core": "^0.37.4",
        "@better-auth/expo": "1.4.9",
        "@convex-dev/auth": "^0.0.90",
        "@convex-dev/better-auth": "^0.10.10",
        "@convex-dev/expo-push-notifications": "^0.3.1",
        "@expo/vector-icons": "^15.0.2",
        "@openrouter/ai-sdk-provider": "^1.5.4",
        "@oslojs/crypto": "^1.0.1",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-segmented-control/segmented-control": "2.5.7",
        "@react-navigation/bottom-tabs": "^7.2.0",
        "@react-navigation/drawer": "^7.1.1",
        "@react-navigation/native": "^7.0.14",
        "@stripe/stripe-react-native": "^0.58.0",
        "ai": "^5.0.121",
        "better-auth": "1.4.9",
        "convex": "^1.32.0",
        "convex-helpers": "^0.1.111",
        "expo": "54.0.22",
        "expo-apple-authentication": "~8.0.8",
        "expo-asset": "~12.0.9",
        "expo-auth-session": "^7.0.8",
        "expo-build-properties": "~1.0.10",
        "expo-camera": "~17.0.10",
        "expo-clipboard": "~8.0.8",
        "expo-constants": "~18.0.13",
        "expo-crypto": "~15.0.6",
        "expo-dev-client": "~6.0.20",
        "expo-device": "~8.0.10",
        "expo-file-system": "~19.0.17",
